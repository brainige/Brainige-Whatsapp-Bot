# Secrets — never commit these. The WhatsApp session folder is a password too.
.env
.wwebjs_auth/

# Private business data: customer conversations, the learned Q&A brain, DM chat
# logs, saved media, LLM context, settings. Keep out of any repo; un-ignore
memory/
media/
logs/
llm_context/

# Local workspace notes + Agentic Debugging and Bot Reviews Reseaching/understanding from customers and friends — never meant for the repo
AGENTS.md
IDEA.md
Bot Reviews/

# Git worktrees used for parallel feature work
.worktrees/

# Old .env copies (real values — never commit)
.env
.env.backup*

# SQLite sidecars (WAL mode) — rebuilt automatically, never needed in git
*.db-wal
*.db-shm

# Node
node_modules/
*.tmp

# OS junk
Thumbs.db
desktop.ini
.DS_Store