# ═══════ VirusTotal API key (free: https://www.virustotal.com) ═══════
VT_API_KEY=

# ═══════ Admin's WhatsApp JID — commands from this number only ═══════
# Format: country code + number + @c.us  (example: 91XXXXXXXXXX@c.us)
ADMIN=

# ═══════ LM Studio server (OpenAI-compatible endpoint) ═══════
LLM_URL=http://127.0.0.1:1234/v1/chat/completions
LLM_MODEL=Qwen3-1.7B-Instruct

# ═══════ Brand & owner identity — change these to run the bot as your own ═══════
# Product name on the terminal banner, !help and the daily digest
BRAND_NAME=Brainige
# How the owner appears in customer replies (English / Bengali / Hindi)
OWNER_DISPLAY=Utsab/Avi
OWNER_DISPLAY_BN=উৎসব/আভি
OWNER_DISPLAY_HI=उत्सब/अवि
# Words that pause replies when a customer addresses you by name (comma separated)
PAUSE_NAMES=utsab,avi
